# PulseWatch local Docker Compose configuration
APP_NAME=PulseWatch
APP_ENV=development
POSTGRES_PASSWORD=pulsewatch_local_only
SESSION_SECRET=replace-this-with-a-long-random-secret-before-sharing
SESSION_TTL_HOURS=168
SESSION_COOKIE=pulsewatch_session
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000
MAX_EVENT_BYTES=262144
INGEST_RATE_PER_MINUTE=120
REDIS_STREAM=pulsewatch:events
REDIS_CONSUMER_GROUP=pulsewatch-workers
REDIS_DEAD_LETTER_STREAM=pulsewatch:events:dead
REDIS_CLAIM_IDLE_MS=60000
LOG_LEVEL=INFO
